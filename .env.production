# Strict CSP for the packaged app (loaded from file://).
# connect-src intentionally allows arbitrary http(s) targets: the client renderer
# talks directly to the Server PC over Radmin VPN private IPv4 addresses.
VITE_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http: https:; object-src 'none'; base-uri 'self'; form-action 'none'
